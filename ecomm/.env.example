# Django Secret Key (generate a secure key for production)
SECRET_KEY=REMOVED_SECRET_KEY

# Set DEBUG to False in production
DEBUG=True

# Comma-separated list of allowed hostnames (e.g. milkmart.onrender.com,localhost)
ALLOWED_HOSTS=*

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com,https://*.railway.app

# Razorpay API Credentials (optional: platform works with test/COD fallback)
RAZOR_KEY_ID=REMOVED_RAZOR_KEY_ID
RAZOR_KEY_SECRET=REMOVED_RAZOR_KEY_SECRET
